# TreinoSport API — Environment Variables
# Copy this file to .env and fill in your values.

# JWT signing secret (min 32 characters)
JWT_SECRET=your_jwt_secret_here

# SQL Server connection string
ConnectionStrings__DataBaseConnection=Server=localhost;Database=TreinoSport;User Id=sa;Password=your_password;TrustServerCertificate=True;

# MongoDB connection string
ConnectionStrings__MongoDB=mongodb://localhost:27017
